    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.0.0",
    "json-server": "^0.17.4",
    "oxlint": "1.86.0",
    "typescript": "6.0.3",
    "vite": "^4.4.0"
  }
}
